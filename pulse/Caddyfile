# Automatic HTTPS reverse proxy for The Daily Pulse.
# APP_DOMAIN / TLS_EMAIL come from the environment (see docker-compose.yml).
# For a quick IP-only test with no domain, set APP_DOMAIN=:80 in .env.

# ── Global options ──────────────────────────────────────────────────
# Behind Cloudflare: trust CF's proxy ranges and read the true visitor IP from
# the CF-Connecting-IP header, so logs, the bot rules below, and the app all see
# real clients instead of Cloudflare. A request NOT coming from these ranges is
# untrusted, so the header can't be forged by someone hitting the origin directly.
{
	servers {
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers Cf-Connecting-Ip
	}
}

{$APP_DOMAIN} {
	root * /var/www/html/public
	encode zstd gzip

	# Let's Encrypt certificate (omit/ignored when APP_DOMAIN is :80)
	tls {$TLS_EMAIL}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# Long cache for versioned assets (CSS/JS are cache-busted with ?v=filemtime).
	@immutable path *.css *.js *.woff2 *.woff *.ttf *.svg *.ico
	header @immutable Cache-Control "public, max-age=31536000, immutable"

	# Media: cache 30 days (filenames are stable/unique).
	@media path /storage/* *.png *.jpg *.jpeg *.webp *.gif
	header @media Cache-Control "public, max-age=2592000"

	# Ordered request handling: block bots FIRST, then protect sensitive paths,
	# then serve the app. A `route` guarantees this top-to-bottom order (outside
	# a route, Caddy would run php_fastcgi before the `respond` and never block).
	route {
		# ── Block unwanted scrapers / SEO bots ──────────────────────────
		# NOTE: deliberately does NOT block Googlebot, Bingbot, DuckDuckBot, or
		# Mediapartners-Google/AdsBot — blocking those would wreck SEO + AdSense.
		# `client_ip` = the REAL visitor (via trusted_proxies above), not Cloudflare.
		# Datacenter scraper range with no legitimate readers (Tencent Cloud —
		# source of the headless-Chrome "Singapore" traffic).
		@bad_ip client_ip 43.128.0.0/10
		respond @bad_ip "Forbidden" 403

		# Known SEO/scraper/research bots by user-agent.
		@bad_ua header_regexp User-Agent (?i)(AhrefsBot|SemrushBot|DataForSeoBot|MJ12bot|DotBot|BLEXBot|PetalBot|Bytespider|Scrapy|python-requests|Go-http-client|ruhr-uni-bochum)
		respond @bad_ua "Forbidden" 403

		# Don't serve dotfiles or sensitive paths.
		@forbidden path /.env* /storage/*.key
		respond @forbidden 404

		# Hand .php requests to the php-fpm "app" service; serve everything else as files.
		php_fastcgi app:9000
		file_server
	}
}

# Redirect www → apex (canonical URL). Caddy auto-provisions HTTPS for both.
# (Only relevant when APP_DOMAIN is a real hostname, not the :80 IP-test mode.)
www.{$APP_DOMAIN} {
	tls {$TLS_EMAIL}
	redir https://{$APP_DOMAIN}{uri} permanent
}
