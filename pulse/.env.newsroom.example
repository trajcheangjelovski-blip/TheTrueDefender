# Merge these keys into the EXISTING .env; retain APP_KEY and database credentials.
AI_PROVIDER=ollama
LOCAL_AI_URL=http://local-ai:8091
LOCAL_AI_TOKEN=
OLLAMA_MODEL=qwen3.5:9b
LOCAL_AI_WAIT_SECONDS=900
AI_PAID_IMAGES=false
LICENSED_IMAGE_HOSTS=
TRUTH_COORDINATOR_URL=http://coordinator:8787
TRUTH_NEWSROOM_TOKEN=
# Redis must be shared by scheduler/workers for unique-job and publication locks.
CACHE_STORE=redis
# Leave the existing general QUEUE_CONNECTION intact; newsroom uses database explicitly.
